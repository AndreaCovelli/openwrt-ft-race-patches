# The digest is the Docker Hub multi-platform index for ubuntu:noble-20260410.
ARG BUILDER_BASE_IMAGE=ubuntu:noble-20260410@sha256:c4a8d5503dfb2a3eb8ab5f807da5bc69a85730fb49b5cfca2330194ebcc41c7b
FROM ${BUILDER_BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive
ARG UBUNTU_SNAPSHOT=20260410T000000Z

RUN find /etc/apt -type f \( -name '*.list' -o -name '*.sources' \) -print0 | \
      xargs -0 -r sed -i \
        -e "s|http://archive.ubuntu.com/ubuntu/|http://snapshot.ubuntu.com/ubuntu/${UBUNTU_SNAPSHOT}/|g" \
        -e "s|https://archive.ubuntu.com/ubuntu/|http://snapshot.ubuntu.com/ubuntu/${UBUNTU_SNAPSHOT}/|g" \
        -e "s|http://security.ubuntu.com/ubuntu/|http://snapshot.ubuntu.com/ubuntu/${UBUNTU_SNAPSHOT}/|g" \
        -e "s|https://security.ubuntu.com/ubuntu/|http://snapshot.ubuntu.com/ubuntu/${UBUNTU_SNAPSHOT}/|g" \
        -e "s|http://ports.ubuntu.com/ubuntu-ports/|http://snapshot.ubuntu.com/ubuntu-ports/${UBUNTU_SNAPSHOT}/|g" \
        -e "s|https://ports.ubuntu.com/ubuntu-ports/|http://snapshot.ubuntu.com/ubuntu-ports/${UBUNTU_SNAPSHOT}/|g" && \
    printf 'Acquire::Check-Valid-Until "false";\n' >/etc/apt/apt.conf.d/99snapshot-valid-until && \
    printf 'Acquire::https::Verify-Peer "false";\n' >/etc/apt/apt.conf.d/98snapshot-bootstrap-ca && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      bash \
      bc \
      bison \
      build-essential \
      bzip2 \
      ca-certificates \
      ccache \
      clang \
      cpio \
      curl \
      file \
      flex \
      g++ \
      g++-multilib \
      gawk \
      gcc-multilib \
      gettext \
      git \
      gperf \
      help2man \
      libelf-dev \
      libncurses-dev \
      libpython3-dev \
      libssl-dev \
      libzstd-dev \
      make \
      ninja-build \
      patch \
      perl \
      pkgconf \
      python3 \
      python3-pyelftools \
      python3-setuptools \
      qemu-utils \
      quilt \
      rsync \
      scons \
      subversion \
      swig \
      tar \
      time \
      unzip \
      util-linux \
      wget \
      xsltproc \
      xz-utils \
      zip \
      zlib1g-dev \
      zstd && \
    rm -f /etc/apt/apt.conf.d/98snapshot-bootstrap-ca && \
    rm -rf /var/lib/apt/lists/*

RUN if ! getent group 1000 >/dev/null; then \
      groupadd --gid 1000 builder; \
    fi && \
    if ! getent passwd 1000 >/dev/null; then \
      useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash builder; \
    fi && \
    install -d -o 1000 -g 1000 /workspace /cache /home/builder

USER 1000:1000
WORKDIR /workspace

ENV HOME=/home/builder

LABEL org.opencontainers.image.source="https://github.com/AndreaCovelli/openwrt-ft-race-patches"

VOLUME ["/workspace", "/cache"]

CMD ["/bin/bash"]
